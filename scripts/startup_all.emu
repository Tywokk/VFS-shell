# Все команды и режимы (этапы 1-3). Запуск с любой VFS:
#   make run ARGS="--vfs vfs/deep.xml --script scripts/startup_all.emu"

# ls: без аргументов и с аргументами
ls
ls -l /home

# cd: без аргументов и с аргументом
cd
cd docs

# лишние пробелы между аргументами не мешают
ls    a     b

# tree: содержимое VFS (служебная команда)
tree

# ошибка: у tree нет аргументов, скрипт остановится на этой строке
tree extra

# эта строка уже не выполнится
exit
